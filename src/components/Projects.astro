---
import Java from "../icons/Java.astro"
import Firebase from "../icons/Firebase.astro"
import Unity from "../icons/Unity.astro"
import Django from "../icons/Django.astro"

//---Para nuestras pills de lenguajes de programación.

import Link from "../components/Link.astro"
import LinkButton from "./LinkButton.astro"
import Github from "../icons/Github.astro"



const TAGS = {
    JAVA: {
      name: "Java",
      class: "bg-blue-950 text-white",
      icon: Java,
    },
    FIREBASE: {
      name: "Firebase",
      class: "bg-orange-600 text-white",
      icon: Firebase,
    },
    UNITY: {
        name: "Unity",
        class: "bg-black text-white",
        icon: Unity,
    },
    DJANGO: {
      name: "Django",
      class: "bg-green-800 text-white",
      icon: Django,

    }
  }

//---Para nuestros poryectos.

const PROJECTS = [
    {
        title: "Pawpets - Mascotas conectadas",
        description: "Pawpet es una red social para tus fieles amigos. Conecta con mascotas del vecindario, organiza reuniones, sube fotos, videos, info. y vacunas. Mantente enterado de las últimas emergencias relacionadas con animales de tu área.",
        link: "#",
        image: "/projects/project-one.webp",    
        tags:[TAGS.FIREBASE, TAGS.JAVA],
    },
  {
    title: "Caminus - Retomando riendas",
    description:
      "Shinshi se ve obligado a retirarse del mundo laboral, ¡Qué alegría..! es lo que uno pensaría. Situado en Japonosaka, país dónde el deber y el trabajo le dan sentido al orgullo y honor.",
    link: "#",
    image: "/projects/project-caminus.webp",
    tags: [TAGS.UNITY],
  },
  {
    title: "AIComplienceCheck - Tu proyecto legalmente",
    description:"En AiComplianceCheck, nos dedicamos a garantizar que los sistemas de inteligencia artificial (IA) y ciencia de datos cumplan con los más altos estándares éticos, legales y técnicos.",
    link:"#",
    github:"https://github.com/Catarz-is/AIComplienceCheck",
    image:"/projects/project-aicomplience.webp",
    tags:[TAGS.DJANGO],
  },
]

---

<!-- Mapeamos así para no poner project a cada segundo. -->
<!-- Screenshot, pildoras de lenguaje, info del proyecto -->
<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
    <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
  <div class="w-full md:w-1/2">
    <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
      <img alt="Recién llegado vs 5 años en Nueva Zelanda" class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105" loading="lazy" src={image} />
    </div>
  </div>

  <div class="w-full md:w-1/2 md:max-w-lg">
    <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
      {title}
    </h3>
    <div class="flex flex-wrap mt-2">
      <ul class="flex flex-row mb-2 gap-x-2">
          {tags.map((tag) => (
            <li>
              <span
                class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
              >
                <tag.icon class="size-4" />
                {tag.name}
              </span>
            </li>
          ))}
        </ul>

      <div class="mt-2 text-gray-700 dark:text-gray-400">{description}</div>
      <footer class="flex items-end justify-start mt-4 gap-x-4">
          {github && (
            <LinkButton href={github}>
              <Github class="size-6" />
              Código
              
            </LinkButton>
          )}
          {link && (
            <LinkButton href={link}>
              <Link class="size-4" />
              Previsualizar
            </LinkButton>
          )}
        </footer>
    </div>
  </div>
</article>
    ))
  }
</div>
